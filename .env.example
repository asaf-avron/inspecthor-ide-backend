# Guardian Gateway - Environment Variables (Docker)
# Copy this file to .env and fill in your values
# This file is used by docker-compose.yml

# ===== Database Configuration =====
# PostgreSQL password (change in production!)
DB_PASSWORD=guardian_dev_password

# ===== Backend API Configuration =====

# Google Gemini API Key for Spec Auditor
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_api_key_here

# API Security
# Generate a secure random key for API_SECRET_KEY
API_SECRET_KEY=your_secret_key_here

# Comma-separated list of allowed API keys for authentication
# Generate secure random keys for production use
ALLOWED_API_KEYS=dev_key_1,dev_key_2

# CORS Configuration
# Comma-separated list of allowed frontend origins
# For Docker: http://localhost:3000,http://frontend:3000
# For production: https://your-frontend-domain.com
CORS_ORIGINS=http://localhost:3000,http://frontend:3000

# Rate Limiting
# Maximum requests per minute per IP address
RATE_LIMIT_PER_MINUTE=60

# ===== Frontend Configuration =====

# API key for frontend to authenticate with backend
# Must match one of the ALLOWED_API_KEYS above
GUARDIAN_API_KEY=dev_key_1

# ===== Production Notes =====
# 
# For production deployment:
# 1. Change DB_PASSWORD to a strong random password
# 2. Generate secure random keys for API_SECRET_KEY and ALLOWED_API_KEYS
# 3. Update CORS_ORIGINS with your production frontend URL
# 4. Set GEMINI_API_KEY with your actual API key
# 5. Consider increasing RATE_LIMIT_PER_MINUTE for production traffic
