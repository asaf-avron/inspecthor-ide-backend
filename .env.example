# Guardian Gateway - Environment Variables (Docker)
# Copy this file to .env and fill in your values
# This file is used by docker-compose.yml

# ===== Database Configuration =====
# Database connection URL
# Option 1: SQLite (for local development with persistence)
# DATABASE_URL=sqlite:///./guardian_gateway.db
# Option 2: PostgreSQL (for production or multi-container setup)
# DATABASE_URL=postgresql://guardian:${DB_PASSWORD}@db:5432/guardian_gateway
# Default: SQLite (sqlite:///./guardian_gateway.db)
DATABASE_URL=sqlite:///./guardian_gateway.db

# PostgreSQL password (only needed if using PostgreSQL)
DB_PASSWORD=guardian_dev_password

# ===== Backend API Configuration =====

# Google Gemini API Key for Spec Auditor
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_api_key_here

# ===== Token Encryption =====
# Used to encrypt GitHub OAuth tokens at rest in the database.
# REQUIRED in production (ENVIRONMENT=production).
# In development, an ephemeral key is generated if not set (data lost on restart).
#
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Environment mode (development/production)
# In production, ENCRYPTION_KEY must be set or the app will fail to start.
ENVIRONMENT=development

# API Security
# Generate a secure random key for API_SECRET_KEY
API_SECRET_KEY=your_secret_key_here

# Comma-separated list of allowed API keys for authentication
# Generate secure random keys for production use
ALLOWED_API_KEYS=dev_key_1,dev_key_2

# CORS Configuration
# Comma-separated list of allowed frontend origins
# For Docker: http://localhost:3000,http://frontend:3000
# For production: https://your-frontend-domain.com
CORS_ORIGINS=http://localhost:3000,http://frontend:3000

# Application URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Rate Limiting
# Maximum requests per minute per IP address
RATE_LIMIT_PER_MINUTE=60

# ===== Verification Service Configuration =====
# URL of the isolated Dafny verification service
# Docker: http://verifier:8001 (internal Docker network)
# Local: http://localhost:8001
VERIFIER_URL=http://verifier:8001

# Set to false to skip verifier service and use local Dafny CLI
USE_VERIFIER_SERVICE=true

# ===== Frontend Configuration =====

# API key for frontend to authenticate with backend
# Must match one of the ALLOWED_API_KEYS above
GUARDIAN_API_KEY=dev_key_1

# ===== GitHub App Configuration (for GitHub Integration) =====
# Required for GitHub webhooks, PR verification, and repository sync
# See docs/GITHUB_APP_SETUP.md for detailed setup instructions

# GitHub App ID (from GitHub App settings page)
GITHUB_APP_ID=

# GitHub App Private Key
# Option 1: Path to .pem file (recommended for local dev)
GITHUB_APP_PRIVATE_KEY_PATH=./github-app-private-key.pem
# Option 2: Inline key (for Docker/production)
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# Webhook Secret (generate in GitHub App settings, must match)
GITHUB_WEBHOOK_SECRET=

# Skip webhook signature validation (for local dev with Smee/proxies)
# Set to true when using Smee.io or other proxies that don't forward signature headers
USE_MOCK_GITHUB=false

# OAuth Client ID and Secret (for user login)
# Get from GitHub App settings → OAuth credentials
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# OAuth Redirect URI (for user login flow)
# Local dev: http://localhost:3000/auth/github/callback
# Production: https://your-domain.com/auth/github/callback
GITHUB_OAUTH_REDIRECT_URI=http://localhost:3000/auth/github/callback

# ===== Production Notes =====
# 
# For production deployment:
# 1. Change DB_PASSWORD to a strong random password
# 2. Generate secure random keys for API_SECRET_KEY and ALLOWED_API_KEYS
# 3. Update CORS_ORIGINS with your production frontend URL
# 4. Set GEMINI_API_KEY with your actual API key
# 5. Consider increasing RATE_LIMIT_PER_MINUTE for production traffic
# 6. For GitHub App: Use production URLs (not ngrok) in GitHub App settings
# 7. Store GITHUB_APP_PRIVATE_KEY securely (use secrets manager in production)
# 8. Set ENCRYPTION_KEY to a persistent Fernet key (required for token encryption)
# 9. Set ENVIRONMENT=production to enforce security requirements